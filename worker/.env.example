# --- Stripe (restricted, read-only key) ---
# Create at: https://dashboard.stripe.com/apikeys → "Create restricted key"
# Permissions needed (all "Read" only): Balance, Charges, Balance Transactions,
# Payouts, Payment Intents
STRIPE_SECRET_KEY=rk_live_replace-me

# --- Kingdomland Kids analytics dashboard ---
KINGDOMLAND_URL=https://dashboard.kingdomlandkids.com
KINGDOMLAND_EMAIL=replace-me@example.com
KINGDOMLAND_PASSWORD=replace-me

# --- Frontend gate ---
TEAM_PASSWORD=replace-me

# --- CORS ---
ALLOWED_ORIGINS=https://kdl-customers-daily-reporting.netlify.app,http://localhost:3030,http://127.0.0.1:3030

# --- Email recipients (comma-separated) ---
REPORT_TO=
REPORT_CC=

MAIL_FROM=Reporting <reporting@sentrystrategy.com>

# Worker port — distinct from Intac (3001) and V3 (3002)
PORT=3003

# Set to 1 to dump the Kingdomland dashboard DOM on next Generate (selector discovery)
DEBUG_DUMP=0
